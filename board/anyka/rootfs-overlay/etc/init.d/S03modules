#!/bin/sh
[ "$1" = "start" ] || exit 0
# quiet console before any module loads (LED driver floods at level 6)
echo 1 > /proc/sys/kernel/printk
M=/usr/modules
echo 256 > /proc/sys/vm/min_free_kbytes

# SD card first (in rootfs, needed by autoupdate)
insmod /lib/modules/ak_mci.ko sdio_clk_mode=1

# persistent config partition
mkdir -p /etc/config
mount -t jffs2 /dev/mtdblock6 /etc/config

[ -d $M ] || { echo "modules: /usr not mounted"; exit 0; }
insmod $M/ak_rtc.ko && hwclock -s
for m in ak_i2c ak_pcm ak_gpio_keys ak_ion ak_leds; do insmod $M/$m.ko; done
echo 1 > /sys/class/leds/red_led/brightness 2>/dev/null
for m in ak_uio exfat ak_motor ak_saradc; do insmod $M/$m.ko; done

# sensor (same as stock sensor_module_load.sh)
insmod $M/ak_isp.ko
insmod $M/sensor_f37p.ko
if [ ! -f /etc/config/isp_f37p_mipi_1lane_h3b.conf ]; then
  rm -f /etc/config/isp_*.conf
  cp /etc/isp_f37p_mipi_1lane_h3b.conf /etc/config/
fi

# entropy seed across boots (no hwrng on this SoC; hostapd needs it for WPA)
if [ -f /etc/config/seed ]; then cat /etc/config/seed > /dev/urandom; fi
dd if=/dev/urandom of=/etc/config/seed bs=512 count=1 2>/dev/null
